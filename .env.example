# Cổng server (mặc định 3000 nếu không set)
PORT=3000

# Chuỗi ký session — bắt buộc khi NODE_ENV=production; dev có thể để trống (app dùng mặc định kém an toàn)
SESSION_SECRET=

# Client secret của ứng dụng trên Keycloak/IdP (client confidential)
CLIENT_SECRET=

# development | production (tùy chọn; production mà thiếu SESSION_SECRET thì app sẽ lỗi khi khởi động)
NODE_ENV=development
